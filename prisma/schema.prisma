// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  user
  static
}

model User {
  id              String @id @default(cuid())
  username        String
  email           String @unique
  password        String
  type            UserType @default(user)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  refreshTokens   RefreshToken[]
  communities     Community[]
  createdSessions Session[] @relation("creator")
  updatedSessions Session[] @relation("updater")
  players         CommunityPlayer[]
}

model RefreshToken {
  jti           String @id
  userId        String
  hashedToken   String
  ipAddress     String?
  userAgent     String?
  isRevoked     Boolean @default(false)
  issuedAt      DateTime @default(now())
  expiresAt     DateTime
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Community {
  id            String @id @default(cuid())
  ownerId       String
  name          String
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  owner         User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  sessions      Session[]
  players       CommunityPlayer[]

  @@index([ownerId])
}

enum Sports {
  badminton
}

model Session {
  id              String @id @default(cuid())
  communityId     String
  name            String
  sport           Sports
  description     String?
  location        String?
  startAt         DateTime?
  endAt           DateTime?
  isAvailable     Boolean @default(true)
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  community       Community @relation(fields: [communityId], references: [id], onDelete:  Cascade, onUpdate: Cascade)
  creator         User? @relation("creator", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: Cascade)
  updater         User? @relation("updater", fields: [updatedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  players         SessionPlayer[]
  courts          Court[]
  matchHistories  MatchHistory[]

  @@index([communityId])
  @@index([createdBy])
}

enum PlayerRoles {
  player
  admin
  host
  owner
}

model CommunityPlayer {
  id                String @id @default(cuid())
  communityId       String
  userId            String
  role              PlayerRoles @default(player)
  createdAt         DateTime @default(now())
  community         Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityPlayer   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionPlayers    SessionPlayer[] @relation("Player")
  adminAccept       SessionPlayer[] @relation("AdminAccept")
  adminUpdate       SessionPlayer[] @relation("AdminUpdate")

  @@unique([communityId, userId])
  @@index([userId])
}

enum GameStatus {
  waiting
  queued
  playing
  paid
}

enum ApplicationStatus {
  accepted
  rejected
}

model SessionPlayer {
  id                String @id @default(cuid())
  sessionId         String
  playerId          String
  gameStatus        GameStatus @default(waiting)
  status            ApplicationStatus @default(accepted)
  isHide            Boolean @default(false)
  requestedAt       DateTime?
  acceptedAt        DateTime?
  acceptedBy        String?
  updateStatus      DateTime @default(now()) // game status updates
  updatedAt         DateTime @updatedAt
  updatedBy         String?
  session           Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionPlayer     CommunityPlayer @relation("Player", fields: [playerId], references: [id], onDelete: Cascade)
  adminAccept       CommunityPlayer? @relation("AdminAccept", fields: [acceptedBy], references: [id], onDelete: SetNull)
  adminUpdate       CommunityPlayer? @relation("AdminUpdate", fields: [updatedBy], references: [id], onDelete: SetNull)

  createdCourts      Court[] @relation("CourtCreator")
  updatedCourts      Court[] @relation("CourtUpdater")
  courtSlot          CourtSlot[]
  matchHistoryPlayers MatchHistoryPlayer[]

  @@unique([sessionId, playerId])
  @@index([playerId])
}

enum CourtStatus {
  idle
  started
  paused
  ended
}

enum CourtType {
  match
  queue
}

model Court {
  id                  String @id @default(cuid())
  sessionId           String
  name                String
  status              CourtStatus @default(idle)
  type                CourtType
  startedAt           DateTime?
  endedAt             DateTime?
  createdBy           String
  updatedBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  session             Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  creator             SessionPlayer @relation("CourtCreator", fields: [createdBy], references: [id])
  updater             SessionPlayer? @relation("CourtUpdater", fields: [updatedBy], references: [id])

  slots               CourtSlot[]

  @@index([sessionId])
}

enum Team {
  a
  b
}

model CourtSlot {
  id                  String @id @default(cuid())
  courtId             String
  sessionPlayerId     String
  position            Int
  team                Team
  isWin               Boolean?
  court               Court @relation(fields: [courtId], references: [id], onDelete: Cascade)
  sessionPlayer       SessionPlayer @relation(fields: [sessionPlayerId], references: [id], onDelete: Cascade)

  @@index([courtId])
  @@index([sessionPlayerId])
}

model MatchHistory {
  id                  String @id @default(cuid())
  sessionId           String?
  courtId             String?
  courtName           String?
  winningTeam         Team
  startedAt           DateTime
  endedAt             DateTime @default(now())
  session             Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  
  matchHistoryPlayer  MatchHistoryPlayer[]

  @@index([sessionId])
  @@index([courtId])
}

model MatchHistoryPlayer {
  id                  String @id @default(cuid())
  matchHistoryId      String
  sessionPlayerId     String
  team                Team
  iswin               Boolean
  matchHistory        MatchHistory @relation(fields: [matchHistoryId], references: [id], onDelete: Cascade)
  sessionPlayer       SessionPlayer @relation(fields: [sessionPlayerId], references: [id], onDelete: Cascade)

  @@index([matchHistoryId])
  @@index([sessionPlayerId])
}